{
  "name": "ts-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "auth:schema:check": "auth check schema --config scripts/auth-check.config.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "test": "vitest run tests/unit",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:workspace": "tsx scripts/test-workspace.ts"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.6",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.6",
    "dotenv": "18.0.4",
    "lucide-react": "1.48.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.6",
    "bun-types": "1.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "type": "module",
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.5.4"
    },
    "mysql2": "3.24.4",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
