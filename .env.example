# Somente placeholders. Valores reais pertencem a .env, ignorado pelo Git.
# Infraestrutura oficial Java.
JAVA_MYSQL_PASSWORD="REPLACE_WITH_JAVA_DATABASE_PASSWORD"
JAVA_MYSQL_ROOT_PASSWORD="REPLACE_WITH_JAVA_ROOT_PASSWORD"
JAVA_DATABASE_URL="jdbc:mysql://127.0.0.1:3309/ts_workspace_java"
JAVA_MYSQL_USER="ts_workspace_java"
FRONTEND_ORIGIN="http://localhost:3000"
JAVA_BOOTSTRAP_ENABLED="false"
JAVA_RBAC_PROVISION_EXISTING="false"
BOOTSTRAP_NAME="REPLACE_WITH_ADMIN_NAME"
BOOTSTRAP_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
BOOTSTRAP_PASSWORD="REPLACE_WITH_AT_LEAST_12_CHARACTERS"

# Storage S3 local (Garage). Gere as chaves reais somente no .env ignorado.
STORAGE_ENDPOINT=http://localhost:3900
STORAGE_REGION=garage
STORAGE_BUCKET=ts-workspace-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_RPC_SECRET=
STORAGE_URL_SECONDS=300

# E-mail desativado até configuração explícita. Mailpit captura somente no ambiente local.
EMAIL_ENABLED=false
EMAIL_FROM=workspace@example.test
SMTP_HOST=127.0.0.1
SMTP_PORT=1029
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
MAILPIT_SMTP_PORT=1029
MAILPIT_UI_PORT=8029
