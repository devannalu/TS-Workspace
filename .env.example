# Somente placeholders. Valores reais pertencem a .env, ignorado pelo Git.
MYSQL_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
MYSQL_ROOT_PASSWORD="REPLACE_WITH_LOCAL_ROOT_PASSWORD"
MYSQL_TEST_PASSWORD="REPLACE_WITH_SEPARATE_TEST_PASSWORD"
MYSQL_TEST_ROOT_PASSWORD="REPLACE_WITH_SEPARATE_TEST_ROOT_PASSWORD"
DATABASE_URL="mysql://ts_workspace:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/ts_workspace"
SHADOW_DATABASE_URL="mysql://ts_workspace:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:3307/ts_workspace_shadow"
TEST_DATABASE_URL="mysql://ts_workspace_test:REPLACE_WITH_SEPARATE_TEST_PASSWORD@127.0.0.1:3308/ts_workspace_test"
BETTER_AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
BETTER_AUTH_URL="http://localhost:3000"

# Apenas para npm run bootstrap; preferir o arquivo .env.bootstrap.local.
BOOTSTRAP_NAME="REPLACE_WITH_ADMIN_NAME"
BOOTSTRAP_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
BOOTSTRAP_PASSWORD="REPLACE_WITH_ADMIN_PASSWORD"
