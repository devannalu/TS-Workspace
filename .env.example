# Somente placeholders. Valores reais pertencem a .env, ignorado pelo Git.
# Infraestrutura Java (banco separado; nunca reutilizar DATABASE_URL do Prisma).
JAVA_MYSQL_PASSWORD="REPLACE_WITH_JAVA_DATABASE_PASSWORD"
JAVA_MYSQL_ROOT_PASSWORD="REPLACE_WITH_JAVA_ROOT_PASSWORD"
JAVA_DATABASE_URL="jdbc:mysql://127.0.0.1:3309/ts_workspace_java"
JAVA_MYSQL_USER="ts_workspace_java"
FRONTEND_ORIGIN="http://localhost:3000"
JAVA_BOOTSTRAP_ENABLED="false"
BOOTSTRAP_NAME="REPLACE_WITH_ADMIN_NAME"
BOOTSTRAP_EMAIL="REPLACE_WITH_ADMIN_EMAIL"
BOOTSTRAP_PASSWORD="REPLACE_WITH_AT_LEAST_12_CHARACTERS"

# Credenciais legadas usadas pelo Compose. O Next le seu proprio frontend/.env.
MYSQL_PASSWORD="REPLACE_WITH_LOCAL_PASSWORD"
MYSQL_ROOT_PASSWORD="REPLACE_WITH_LOCAL_ROOT_PASSWORD"
MYSQL_TEST_PASSWORD="REPLACE_WITH_SEPARATE_TEST_PASSWORD"
MYSQL_TEST_ROOT_PASSWORD="REPLACE_WITH_SEPARATE_TEST_ROOT_PASSWORD"
# URLs Prisma, Better Auth e bootstrap: consulte frontend/.env.example.
